{
  "name": "sidra",
  "version": "0.1.0",
  "private": true,
  "description": "Sidra \u2014 a curated luxury digital ecosystem for resin art and handcrafted goods.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore \"npm test --prefix tests/rules\"",
    "functions:install": "npm install --prefix firebase/functions",
    "functions:build": "npm run build --prefix firebase/functions",
    "rules:install": "npm install --prefix tests/rules"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "firebase": "12.16.0",
    "framer-motion": "12.42.2",
    "gsap": "^3.13.0",
    "next": "15.5.16",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.16",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@eslint/eslintrc": "^3.3.1"
  }
}
