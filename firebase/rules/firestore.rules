rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0 exposes no writable product data. Domain rules arrive alongside schemas.
    match /cms/{documentId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}