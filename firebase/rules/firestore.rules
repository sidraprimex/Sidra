rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function founder() { return role() in ['founder', 'superAdmin']; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    match /cms/{documentId} {
      allow read: if true;
      allow write: if founder() || role() == 'contentManager';
    }

    match /users/{uid} {
      allow read: if ownUser(uid) || founder();
      allow create: if ownUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.role == 'customer'
        && request.resource.data.studioId == null
        && request.resource.data.status == 'active'
        && request.resource.data.wishlistCount == 0
        && request.resource.data.orderCount == 0
        && request.resource.data.loyaltyPoints == 0;
      allow update: if founder() || (
        ownUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'profilePhoto', 'preferredLanguage',
          'notificationPreferences', 'email', 'emailVerified',
          'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.role == resource.data.role
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.status == resource.data.status
      );
      allow delete: if false;
    }

    match /wishlists/{uid} {
      allow read: if ownUser(uid);
      allow create, update: if ownUser(uid) && verified();
      allow delete: if ownUser(uid);
    }

    match /carts/{uid} {
      allow read: if ownUser(uid);
      allow create, update: if ownUser(uid) && verified();
      allow delete: if ownUser(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
