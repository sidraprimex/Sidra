rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return signedIn() ? request.auth.uid : null; }
    function configuredAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "syedafsharkhadri63@gmail.com";
    }
    function userPath(userId) { return /databases/$(database)/documents/users/$(userId); }
    function profileExists() { return signedIn() && exists(userPath(uid())); }
    function profileData() { return get(userPath(uid())).data; }
    function role() {
      return configuredAdmin()
        ? 'admin'
        : (profileExists() ? profileData().role : null);
    }
    function studioId() { return profileExists() ? profileData().studioId : null; }
    function activeAccount() { return configuredAdmin() || !profileExists() || profileData().status == 'active'; }
    function verified() { return signedIn() && request.auth.token.email_verified == true && activeAccount(); }
    function seller() { return role() == 'seller'; }
    function sameStudio(value) { return signedIn() && studioId() != null && studioId() == value; }
    function founder() { return role() in ['admin', 'founder', 'superAdmin']; }
    function supportAdmin() { return role() in ['admin', 'support', 'founder', 'superAdmin']; }
    function contentAdmin() { return role() in ['admin', 'contentManager', 'founder', 'superAdmin']; }
    function financeAdmin() { return role() in ['admin', 'financeManager', 'founder', 'superAdmin']; }
    function marketingAdmin() { return role() in ['admin', 'marketingManager', 'contentManager', 'founder', 'superAdmin']; }
    function anyAdmin() { return role() in ['admin', 'support', 'contentManager', 'financeManager', 'marketingManager', 'founder', 'superAdmin']; }
    function isAuthenticated() { return signedIn(); }
    function isFounder() { return founder(); }
    function isSeller() { return seller(); }
    function ownUser(userId) { return signedIn() && uid() == userId; }
    function ownStudio(value) { return signedIn() && studioId() != null && studioId() == value; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function createdOnly(fields) { return request.resource.data.keys().hasOnly(fields); }
    function validText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function customOrderPath(orderId) { return /databases/$(database)/documents/customOrders/$(orderId); }
    function customOrderExists(orderId) { return exists(customOrderPath(orderId)); }
    function customOrderData(orderId) { return get(customOrderPath(orderId)).data; }
    function customOrderParticipant(orderId) {
      return signedIn()
        && customOrderExists(orderId)
        && (
          customOrderData(orderId).customerId == uid()
          || sameStudio(customOrderData(orderId).studioId)
          || supportAdmin()
        );
    }
    function customOrderChatOpen(orderId) {
      return customOrderExists(orderId)
        && customOrderData(orderId).chatUnlocked == true
        && customOrderData(orderId).paymentStatus == 'verified'
        && customOrderData(orderId).status in [
          'paid', 'inProduction', 'proofReady',
          'revisionRequested', 'approved', 'readyToShip',
          'shipped', 'delivered', 'disputed'
        ];
    }

    match /users/{userId} {
      allow read: if ownUser(userId) || founder();
      allow create: if ownUser(userId)
        && request.resource.data.uid == uid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.role == 'customer'
        && request.resource.data.studioId == null
        && request.resource.data.status == 'active'
        && request.resource.data.wishlistCount == 0
        && request.resource.data.orderCount == 0
        && request.resource.data.loyaltyPoints == 0;
      allow update: if founder() || (
        ownUser(userId)
        && changedOnly([
          'fullName', 'phone', 'profilePhoto', 'preferredLanguage',
          'notificationPreferences', 'email', 'emailVerified',
          'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.role == resource.data.role
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.status == resource.data.status
      );
      allow delete: if false;
    }

    match /studios/{documentId} {
      allow read: if resource.data.active == true || ownStudio(documentId) || anyAdmin();
      allow create: if founder();
      allow update: if founder() || (
        ownStudio(documentId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.subscriptionTier == resource.data.subscriptionTier
        && request.resource.data.verificationBadge == resource.data.verificationBadge
        && request.resource.data.featured == resource.data.featured
        && request.resource.data.active == resource.data.active
        && changedOnly(['name', 'description', 'logoUrl', 'bannerUrl', 'galleryUrls', 'category', 'seo', 'policies', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /studioStorefronts/{documentId} {
      allow read: if true;
      allow create: if founder() || (verified() && seller() && sameStudio(documentId) && request.resource.data.studioId == documentId && request.resource.data.sellerUid == uid() && request.resource.data.layout in ['editorial', 'gallery', 'catalog'] && request.resource.data.heroAlignment in ['left', 'center'] && request.resource.data.accentColor is string && request.resource.data.accentColor.size() <= 16 && request.resource.data.headline is string && request.resource.data.headline.size() <= 140 && request.resource.data.announcement is string && request.resource.data.announcement.size() <= 180 && request.resource.data.collections is list && request.resource.data.collections.size() <= 20);
      allow update: if founder() || (verified() && seller() && sameStudio(documentId) && request.resource.data.studioId == resource.data.studioId && request.resource.data.sellerUid == resource.data.sellerUid && request.resource.data.layout in ['editorial', 'gallery', 'catalog'] && request.resource.data.heroAlignment in ['left', 'center'] && request.resource.data.collections is list && request.resource.data.collections.size() <= 20 && changedOnly(['announcement', 'headline', 'accentColor', 'layout', 'heroAlignment', 'showStory', 'showCollections', 'showPolicies', 'collections', 'updatedAt']));
      allow delete: if founder();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'published' || ownStudio(resource.data.studioId) || anyAdmin();
      allow create: if verified()
        && role() == 'seller'
        && request.resource.data.productId == productId
        && ownStudio(request.resource.data.studioId)
        && request.resource.data.status in ['draft', 'pendingReview'];
      allow update: if founder() || contentAdmin() || (
        verified()
        && role() == 'seller'
        && ownStudio(resource.data.studioId)
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.productId == resource.data.productId
        && (
          request.resource.data.status in ['draft', 'pendingReview', 'published', 'hidden', 'archived']
          || (resource.data.status == 'published' && request.resource.data.status == 'published')
        )
        && changedOnly([
          'name', 'slug', 'shortDescription', 'description', 'story',
          'category', 'categoryId', 'categorySlug', 'collectionIds',
          'price', 'pricePaise', 'salePrice', 'salePricePaise', 'sku',
          'inventoryCount', 'inventoryMode', 'images', 'videos', 'media',
          'heroImageUrl', 'generatedVideoUrl', 'variants', 'materials',
          'dimensions', 'weight', 'weightGrams', 'productionTimeDays',
          'shippingTimeDays', 'status', 'submittedAt', 'publishedAt',
          'archivedAt', 'seo', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    match /productCostings/{productId} {
      allow read: if founder()
        || (seller() && sameStudio(resource.data.studioId));
      allow create: if verified()
        && seller()
        && sameStudio(request.resource.data.studioId)
        && request.resource.data.productId == productId
        && request.resource.data.sellerId == uid();
      allow update: if founder() || (
        seller()
        && sameStudio(resource.data.studioId)
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.sellerId == resource.data.sellerId
        && changedOnly([
          'makingCostPaise', 'sellerShippingCostPaise', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || contentAdmin();
      allow create, update: if contentAdmin();
      allow delete: if founder();
    }

    match /collections/{collectionId} {
      allow read: if resource.data.active == true || contentAdmin();
      allow create, update: if contentAdmin();
      allow delete: if founder();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid()
        || ownStudio(resource.data.studioId)
        || supportAdmin()
        || financeAdmin()
      );
      allow update: if seller()
        && ownStudio(resource.data.studioId)
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && resource.data.paymentStatus == 'paid'
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == resource.data.timeline.size() + 1
        && (
          (
            (
              (resource.data.orderStatus == 'placed' && request.resource.data.orderStatus == 'accepted')
              || (resource.data.orderStatus == 'accepted' && request.resource.data.orderStatus == 'inProduction')
              || (resource.data.orderStatus == 'inProduction' && request.resource.data.orderStatus == 'qualityCheck')
              || (resource.data.orderStatus == 'qualityCheck' && request.resource.data.orderStatus == 'packaged')
            )
            && changedOnly(['orderStatus', 'timeline', 'updatedAt'])
          )
          || (
            resource.data.orderStatus == 'packaged'
            && request.resource.data.orderStatus == 'readyToShip'
            && request.resource.data.shippingPackage is map
            && request.resource.data.shippingPackage.provider == 'delhivery'
            && validText(request.resource.data.shippingPackage.trackingNumber, 3, 80)
            && request.resource.data.shippingPackage.weightGrams > 0
            && request.resource.data.shippingPackage.lengthCm > 0
            && request.resource.data.shippingPackage.widthCm > 0
            && request.resource.data.shippingPackage.heightCm > 0
            && changedOnly([
              'orderStatus', 'shippingPackage', 'timeline', 'updatedAt'
            ])
          )
        );
      allow create, delete: if false;
    }

    match /sellerVerifications/{studioId} {
      allow get: if founder() || (seller() && sameStudio(studioId));
      allow list: if founder();
      allow create: if verified()
        && seller()
        && sameStudio(studioId)
        && request.resource.data.studioId == studioId
        && request.resource.data.sellerUid == uid()
        && request.resource.data.status == 'submitted'
        && request.resource.data.documentPaths is list
        && request.resource.data.pickupAddress is map;
      allow update: if founder() || (
        verified()
        && seller()
        && sameStudio(studioId)
        && resource.data.sellerUid == uid()
        && resource.data.status != 'verified'
        && request.resource.data.studioId == studioId
        && request.resource.data.sellerUid == uid()
        && request.resource.data.status == 'submitted'
        && request.resource.data.documentPaths is list
        && request.resource.data.pickupAddress is map
      );
      allow delete: if false;
    }

    match /shippingLedgers/{orderId} {
      allow read: if signedIn() && (
        resource.data.studioId == studioId()
        || supportAdmin()
        || financeAdmin()
      );
      allow create: if seller()
        && request.resource.data.orderId == orderId
        && request.resource.data.studioId == studioId()
        && request.resource.data.provider == 'delhivery'
        && request.resource.data.sellerOutOfPocketPaise == 0
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.studioId == studioId();
      allow update, delete: if financeAdmin();
    }

    match /payouts/{payoutId} {
      allow create: if seller()
        && payoutId == 'making-' + request.resource.data.orderId
        && request.resource.data.studioId == studioId()
        && request.resource.data.sellerUid == uid()
        && request.resource.data.type == 'makingAdvance'
        && request.resource.data.status == 'available'
        && request.resource.data.commissionPaise == 0
        && request.resource.data.grossPaise == request.resource.data.sellerAmountPaise
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.orderStatus == 'qualityCheck'
        && getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.makingAdvancePaise == request.resource.data.sellerAmountPaise;
    }

    match /customOrders/{requestId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid()
        || ownStudio(resource.data.studioId)
        || supportAdmin()
      );
      allow create: if verified()
        && request.resource.data.customOrderId == requestId
        && request.resource.data.customerId == uid()
        && validText(request.resource.data.customerName, 1, 140)
        && validText(request.resource.data.studioId, 1, 180)
        && validText(request.resource.data.studioName, 1, 140)
        && exists(/databases/$(database)/documents/studios/$(request.resource.data.studioId))
        && get(/databases/$(database)/documents/studios/$(request.resource.data.studioId)).data.active == true
        && (
          !('status' in get(/databases/$(database)/documents/studios/$(request.resource.data.studioId)).data)
          || get(/databases/$(database)/documents/studios/$(request.resource.data.studioId)).data.status != 'suspended'
        )
        && (
          !('contactEnabled' in get(/databases/$(database)/documents/studios/$(request.resource.data.studioId)).data)
          || get(/databases/$(database)/documents/studios/$(request.resource.data.studioId)).data.contactEnabled != false
        )
        && request.resource.data.status == 'submitted'
        && request.resource.data.brief is map
        && validText(request.resource.data.brief.title, 3, 140)
        && validText(request.resource.data.brief.description, 40, 5000)
        && validText(request.resource.data.brief.targetDeliveryDate, 8, 40)
        && request.resource.data.quote == null
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0
        && request.resource.data.proofs is list
        && request.resource.data.proofs.size() == 0
        && request.resource.data.paymentStatus == 'notSubmitted'
        && request.resource.data.paymentReference == null
        && request.resource.data.paymentSubmittedAt == null
        && request.resource.data.paymentVerifiedAt == null
        && request.resource.data.paymentVerifiedBy == null
        && request.resource.data.paymentReviewNote == null
        && request.resource.data.chatUnlocked == false
        && request.resource.data.linkedOrderId == null
        && request.resource.data.timeline is list
        && request.resource.data.timeline.size() == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'customOrderId', 'customerId', 'customerName',
          'studioId', 'studioName', 'status', 'brief', 'quote',
          'messages', 'proofs', 'paymentStatus',
          'paymentReference', 'paymentSubmittedAt',
          'paymentVerifiedAt', 'paymentVerifiedBy',
          'paymentReviewNote', 'chatUnlocked', 'linkedOrderId',
          'timeline', 'createdAt', 'updatedAt'
        ]);
      allow update: if founder()
        || (
          verified()
          && seller()
          && sameStudio(resource.data.studioId)
          && resource.data.status in [
            'submitted', 'sellerReview', 'clarificationRequested'
          ]
          && request.resource.data.status == 'quoteSent'
          && request.resource.data.quote is map
          && validText(request.resource.data.quote.quoteId, 1, 180)
          && request.resource.data.quote.pricePaise is int
          && request.resource.data.quote.pricePaise > 0
          && request.resource.data.quote.shippingPaise is int
          && request.resource.data.quote.shippingPaise >= 0
          && request.resource.data.quote.totalPaise
            == request.resource.data.quote.pricePaise
              + request.resource.data.quote.shippingPaise
          && request.resource.data.quote.productionDays is int
          && request.resource.data.quote.productionDays > 0
          && request.resource.data.quote.revisionLimit is int
          && request.resource.data.quote.revisionLimit >= 0
          && validText(request.resource.data.quote.expiresAt, 8, 40)
          && validText(request.resource.data.quote.terms, 20, 5000)
          && request.resource.data.quote.acceptedAt == null
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.timeline is list
          && request.resource.data.timeline.size()
            == resource.data.timeline.size() + 1
          && request.resource.data.updatedAt == request.time
          && changedOnly([
            'status', 'quote', 'timeline', 'updatedAt'
          ])
        )
        || (
          verified()
          && resource.data.customerId == uid()
          && resource.data.status in ['quoteSent', 'paymentPending']
          && request.resource.data.status == 'paymentPending'
          && request.resource.data.paymentStatus == 'pendingVerification'
          && validText(request.resource.data.paymentReference, 4, 180)
          && request.resource.data.paymentSubmittedAt == request.time
          && request.resource.data.paymentVerifiedAt == null
          && request.resource.data.paymentVerifiedBy == null
          && request.resource.data.paymentReviewNote == null
          && request.resource.data.chatUnlocked == false
          && request.resource.data.quote.pricePaise == resource.data.quote.pricePaise
          && request.resource.data.quote.shippingPaise == resource.data.quote.shippingPaise
          && request.resource.data.quote.totalPaise == resource.data.quote.totalPaise
          && request.resource.data.quote.quoteId == resource.data.quote.quoteId
          && request.resource.data.quote.acceptedAt is string
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.updatedAt == request.time
          && changedOnly([
            'status', 'quote', 'paymentStatus',
            'paymentReference', 'paymentSubmittedAt',
            'paymentVerifiedAt', 'paymentVerifiedBy',
            'paymentReviewNote', 'chatUnlocked', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    match /customOrderMessages/{messageId} {
      allow read: if supportAdmin()
        || (
          customOrderParticipant(resource.data.customOrderId)
          && customOrderChatOpen(resource.data.customOrderId)
        );
      allow create: if verified()
        && request.resource.data.messageId == messageId
        && validText(request.resource.data.customOrderId, 1, 180)
        && customOrderParticipant(request.resource.data.customOrderId)
        && customOrderChatOpen(request.resource.data.customOrderId)
        && request.resource.data.customerId
          == customOrderData(request.resource.data.customOrderId).customerId
        && request.resource.data.studioId
          == customOrderData(request.resource.data.customOrderId).studioId
        && request.resource.data.senderId == uid()
        && (
          (
            request.resource.data.senderRole == 'customer'
            && customOrderData(request.resource.data.customOrderId).customerId == uid()
          )
          || (
            request.resource.data.senderRole == 'seller'
            && seller()
            && sameStudio(request.resource.data.studioId)
          )
        )
        && validText(request.resource.data.body, 1, 5000)
        && request.resource.data.attachmentUrls is list
        && request.resource.data.attachmentUrls.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'messageId', 'customOrderId', 'customerId', 'studioId',
          'senderId', 'senderRole', 'body', 'attachmentUrls',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || resource.data.moderationStatus == 'visible' || ownStudio(resource.data.studioId) || supportAdmin();
      allow create: if false;
      allow update: if supportAdmin() || (
        signedIn()
        && resource.data.customerId == uid()
        && resource.data.verifiedPurchase == true
        && request.time < resource.data.editableUntil
        && request.resource.data.verifiedPurchase == resource.data.verifiedPurchase
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.studioId == resource.data.studioId
        && changedOnly(['rating', 'title', 'body', 'imageUrls'])
      );
      allow delete: if false;
    }

    match /followers/{followerId} {
      allow read: if signedIn() && (resource.data.customerId == uid() || ownStudio(resource.data.studioId) || anyAdmin());
      allow create: if verified()
        && request.resource.data.customerId == uid()
        && request.resource.data.followerId == followerId;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.customerId == uid() || founder());
    }

    match /wishlists/{userId} {
      allow read: if ownUser(userId);
      allow create, update: if ownUser(userId) && verified() && request.resource.data.uid == uid();
      allow delete: if ownUser(userId);
    }

    match /carts/{userId} {
      allow read: if ownUser(userId);
      allow create, update: if ownUser(userId) && verified() && request.resource.data.uid == uid();
      allow delete: if ownUser(userId);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.recipientUid == uid() || supportAdmin());
      allow create: if false;
      allow update: if signedIn()
        && resource.data.recipientUid == uid()
        && request.resource.data.recipientUid == resource.data.recipientUid
        && changedOnly(['read', 'readAt']);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (
        resource.data.senderUid == uid()
        || uid() in resource.data.recipientUids
        || supportAdmin()
      );

      allow create: if verified()
        && request.resource.data.messageId == messageId
        && request.resource.data.senderUid == uid()
        && request.resource.data.contextType == 'supportTicket'
        && validText(request.resource.data.body, 1, 5000)
        && request.resource.data.recipientUids is list
        && request.resource.data.attachmentUrls is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.editedAt == null
        && request.resource.data.deleted == false
        && request.resource.data.system == false
        && existsAfter(
          /databases/$(database)/documents/supportTickets/$(request.resource.data.contextId)
        )
        && (
          getAfter(
            /databases/$(database)/documents/supportTickets/$(request.resource.data.contextId)
          ).data.openedByUid == uid()
          || ownStudio(
            getAfter(
              /databases/$(database)/documents/supportTickets/$(request.resource.data.contextId)
            ).data.studioId
          )
          || supportAdmin()
        )
        && request.resource.data.keys().hasOnly([
          'messageId', 'conversationId', 'contextType', 'contextId',
          'senderUid', 'recipientUids', 'body', 'attachmentUrls',
          'createdAt', 'editedAt', 'deleted', 'system'
        ]);

      allow update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid()
        || resource.data.openedByUid == uid()
        || ownStudio(resource.data.studioId)
        || supportAdmin()
      );

      allow create: if verified()
        && request.resource.data.ticketId == ticketId
        && request.resource.data.customerId == uid()
        && request.resource.data.openedByUid == uid()
        && request.resource.data.studioId == null
        && request.resource.data.assignedAdminUid == null
        && validText(request.resource.data.subject, 5, 140)
        && validText(request.resource.data.description, 10, 5000)
        && request.resource.data.category in [
          'order', 'customOrder', 'product',
          'payment', 'account', 'other'
        ]
        && request.resource.data.status == 'open'
        && request.resource.data.priority == 'normal'
        && request.resource.data.attachmentUrls is list
        && request.resource.data.satisfactionRating == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.closedAt == null
        && request.resource.data.keys().hasOnly([
          'ticketId', 'customerId', 'studioId', 'openedByUid',
          'assignedAdminUid', 'subject', 'category', 'description',
          'orderId', 'productId', 'attachmentUrls', 'conversationId',
          'status', 'priority', 'satisfactionRating', 'lastMessageAt',
          'createdAt', 'updatedAt', 'closedAt'
        ]);

      allow update: if supportAdmin() || (
        signedIn()
        && resource.data.openedByUid == uid()
        && request.resource.data.openedByUid == resource.data.openedByUid
        && request.resource.data.ticketId == resource.data.ticketId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && changedOnly(['updatedAt', 'lastMessageAt', 'status'])
        && (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status == 'waitingOnCustomer'
            && request.resource.data.status == 'inProgress'
          )
        )
      );

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if financeAdmin();
      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if financeAdmin() || ownStudio(resource.data.studioId);
      allow create, update: if financeAdmin();
      allow delete: if false;
    }

    match /sellerWithdrawals/{withdrawalId} {
      allow read: if financeAdmin() || ownStudio(resource.data.studioId);
      allow create: if verified()
        && seller()
        && sameStudio(request.resource.data.studioId)
        && request.resource.data.sellerUid == uid()
        && request.resource.data.amountPaise is int
        && request.resource.data.amountPaise >= 50000
        && request.resource.data.amountPaise <= 100000000
        && request.resource.data.method in ['upi', 'bank', 'imps']
        && request.resource.data.destination is map
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentReference == null
        && request.resource.data.adminNote == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if financeAdmin()
        && !(resource.data.status in ['paid', 'rejected'])
        && request.resource.data.studioId == resource.data.studioId
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.amountPaise == resource.data.amountPaise
        && request.resource.data.method == resource.data.method
        && request.resource.data.destination == resource.data.destination
        && request.resource.data.status in ['processing', 'paid', 'rejected']
        && request.resource.data.updatedAt == request.time
        && changedOnly([
          'status', 'paymentReference', 'adminNote', 'reviewedBy',
          'reviewedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if signedIn() || marketingAdmin();
      allow create, update: if marketingAdmin();
      allow delete: if founder();
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.status == 'active' || marketingAdmin();
      allow create, update: if marketingAdmin();
      allow delete: if founder();
    }

    match /journal/{articleId} {
      allow read: if resource.data.status == 'published' || contentAdmin();
      allow create, update: if contentAdmin();
      allow delete: if founder();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create: if verified() && request.resource.data.createdBy == uid();
      allow update: if signedIn() && (resource.data.createdBy == uid() || contentAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == uid() || founder());
    }

    match /analytics/{analyticsId} {
      allow read: if anyAdmin() || ownStudio(resource.data.subjectId);
      allow create, update, delete: if false;
    }

    match /cms/{documentId} {
      allow read: if true;
      allow create, update: if contentAdmin();
      allow delete: if founder();
    }

    match /settings/{documentId} {
      allow read: if documentId == "theme" || signedIn();
      allow create, update: if founder();
      allow delete: if false;
    }

    match /automationRules/{ruleId} {
      allow read, create, update: if founder();
      allow delete: if founder();
    }

    match /auditLogs/{logId} {
      allow read: if anyAdmin();
      allow create, update, delete: if false;
    }

    match /corporateLeads/{leadId} {
      allow create: if request.resource.data.leadId == leadId
        && validText(request.resource.data.companyName, 2, 160)
        && validText(request.resource.data.contactName, 2, 120)
        && validText(request.resource.data.email, 3, 320);
      allow read, update: if marketingAdmin() || supportAdmin();
      allow delete: if founder();
    }

    match /seo/{seoId} {
      allow read: if true;
      allow create, update: if marketingAdmin();
      allow delete: if founder();
    }

    match /affiliates/{documentId} { allow read, write: if false; }
    match /giftCards/{documentId} { allow read, write: if false; }
    match /loyaltyLedger/{documentId} { allow read, write: if false; }
    match /subscriptionsBilling/{documentId} { allow read, write: if false; }

    match /studios/{studioId} {
      allow read: if founder() || sameStudio(studioId) || resource.data.active == true;
      allow create: if false;
      allow update: if founder() || (
        seller() && sameStudio(studioId)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.active == resource.data.active
        && request.resource.data.provisioningState == resource.data.provisioningState
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'logoUrl', 'bannerUrl', 'galleryUrls', 'category',
          'seo', 'policies', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    match /sellerApplications/{applicationId} {
      allow read: if founder()
        || (
          signedIn()
          && (
            applicationId == uid()
            || resource.data.uid == request.auth.uid
          )
        );

      allow create: if verified()
        && applicationId == uid()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'uploading'
        && request.resource.data.studioId == null
        && request.resource.data.slug == null
        && request.resource.data.reviewNote == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.failureReason == null
        && request.resource.data.storageProvider == 'b2'
        && request.resource.data.telegramChatId == null
        && request.resource.data.telegramHeaderMessageId == null
        && request.resource.data.accessFeePaise == 0
        && request.resource.data.installmentAmountsPaise is list
        && request.resource.data.installmentAmountsPaise.size() == 0
        && request.resource.data.paymentAmountPaise == 0
        && request.resource.data.paymentInstallmentNumber == null
        && request.resource.data.paymentMethod == null
        && request.resource.data.paymentReference == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.paymentSubmittedAt == null
        && request.resource.data.paymentVerifiedAt == null
        && request.resource.data.provisionedAt == null
        && request.resource.data.fullName is string
        && request.resource.data.studioName is string
        && request.resource.data.mobile is string
        && request.resource.data.city is string
        && request.resource.data.state is string
        && request.resource.data.experience is string
        && request.resource.data.whyJoin is string
        && (
          request.resource.data.instagram == null
          || request.resource.data.instagram is string
        )
        && request.resource.data.productCategories is list
        && request.resource.data.productCategories.size() >= 1
        && request.resource.data.productCategories.size() <= 20
        && request.resource.data.expectedMonthlyCapacity is int
        && request.resource.data.expectedMonthlyCapacity >= 1
        && request.resource.data.expectedMonthlyCapacity <= 100000
        && request.resource.data.portfolioImages is list
        && request.resource.data.portfolioImages.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'studioName', 'email', 'mobile', 'city',
          'state', 'portfolioImages', 'instagram', 'experience',
          'productCategories', 'whyJoin', 'expectedMonthlyCapacity',
          'status', 'reviewNote', 'reviewedBy', 'studioId', 'slug',
          'failureReason', 'storageProvider', 'telegramChatId',
          'telegramHeaderMessageId', 'accessFeePaise',
          'installmentAmountsPaise', 'paymentAmountPaise',
          'paymentInstallmentNumber',
          'paymentMethod', 'paymentReference', 'createdAt', 'updatedAt',
          'reviewedAt', 'paymentSubmittedAt', 'paymentVerifiedAt',
          'provisionedAt'
        ]);

      allow update: if founder() || (
        verified()
        && resource.data.uid == uid()
        && request.resource.data.uid == resource.data.uid
        && (
          (
            resource.data.status in ['uploading', 'submissionFailed']
            && request.resource.data.status in [
              'uploading',
              'submissionFailed',
              'pending'
            ]
            && request.resource.data.updatedAt == request.time
            && changedOnly([
              'status',
              'portfolioImages',
              'failureReason',
              'storageProvider',
              'telegramChatId',
              'telegramHeaderMessageId',
              'updatedAt'
            ])
            && request.resource.data.storageProvider == 'b2'
            && (
              (
                request.resource.data.status == 'pending'
                && request.resource.data.failureReason == null
                && request.resource.data.telegramChatId == null
                && request.resource.data.telegramHeaderMessageId == null
                && request.resource.data.portfolioImages is list
                && request.resource.data.portfolioImages.size() >= 1
                && request.resource.data.portfolioImages.size() <= 8
                && request.resource.data.portfolioImages[0].provider
                  == 'b2'
                && request.resource.data.portfolioImages[0].ownerUid
                  == request.auth.uid
                && request.resource.data.portfolioImages[0].path is string
              )
              || (
                request.resource.data.status == 'uploading'
                && request.resource.data.failureReason == null
                && request.resource.data.portfolioImages is list
                && request.resource.data.portfolioImages.size() <= 8
                && (
                  request.resource.data.portfolioImages.size() == 0
                  || (
                    request.resource.data.portfolioImages[0].provider
                      == 'b2'
                    && request.resource.data.portfolioImages[0].ownerUid
                      == request.auth.uid
                  )
                )
                && request.resource.data.telegramChatId == null
                && request.resource.data.telegramHeaderMessageId == null
              )
              || (
                request.resource.data.status == 'submissionFailed'
                && validText(
                  request.resource.data.failureReason,
                  1,
                  2000
                )
                && request.resource.data.portfolioImages is list
                && request.resource.data.portfolioImages.size() <= 8
                && (
                  request.resource.data.portfolioImages.size() == 0
                  || (
                    request.resource.data.portfolioImages[0].provider
                      == 'b2'
                    && request.resource.data.portfolioImages[0].ownerUid
                      == request.auth.uid
                  )
                )
              )
            )
          )
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'paymentSubmitted'
            && request.resource.data.paymentMethod in [
              'manual',
              'razorpayLink'
            ]
            && validText(
              request.resource.data.paymentReference,
              4,
              180
            )
            && request.resource.data.paymentSubmittedAt == request.time
            && request.resource.data.paymentAmountPaise is int
            && request.resource.data.paymentAmountPaise > 0
            && request.resource.data.paymentAmountPaise <= resource.data.accessFeePaise
            && (
              request.resource.data.paymentAmountPaise == resource.data.accessFeePaise
              || (
                resource.data.installmentAmountsPaise.size() > 0
                && request.resource.data.paymentAmountPaise == resource.data.installmentAmountsPaise[0]
                && request.resource.data.paymentInstallmentNumber == 1
              )
            )
            && request.resource.data.updatedAt == request.time
            && changedOnly([
              'status',
              'paymentMethod',
              'paymentReference',
              'paymentAmountPaise',
              'paymentInstallmentNumber',
              'paymentSubmittedAt',
              'updatedAt'
            ])
          )
        )
      );

      allow delete: if false;
    }

    match /sellerInstallmentSchedules/{studioId} {
      allow read: if founder() || sameStudio(studioId);
      allow create, update: if founder();
      allow delete: if false;
    }

    match /sellerSubscriptionRequests/{requestId} {
      allow read: if founder()
        || (signedIn() && resource.data.sellerUid == uid());
      allow create: if verified()
        && seller()
        && request.resource.data.sellerUid == uid()
        && sameStudio(request.resource.data.studioId)
        && request.resource.data.plan in ['starter', 'growth', 'luxury', 'custom']
        && request.resource.data.status == 'pending'
        && request.resource.data.monthlyFeePaise is int
        && request.resource.data.monthlyFeePaise >= 0
        && request.resource.data.maximumCommissionBasisPoints is int
        && request.resource.data.maximumCommissionBasisPoints >= 0
        && request.resource.data.maximumCommissionBasisPoints <= 1200
        && validText(request.resource.data.paymentReference, 4, 180);
      allow update: if founder();
      allow delete: if false;
    }

    match /studioRoutes/{slug} {
      allow read: if true;
      allow write: if founder();
    }

    match /manualPaymentRequests/{requestId} {
      allow create: if verified()
        && request.resource.data.customerId == uid()
        && validText(request.resource.data.addressId, 1, 180)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.subtotalPaise is int
        && request.resource.data.subtotalPaise > 0
        && request.resource.data.shippingPaise is int
        && request.resource.data.shippingPaise >= 0
        && request.resource.data.discountPaise is int
        && request.resource.data.discountPaise >= 0
        && request.resource.data.discountPaise <= request.resource.data.subtotalPaise
        && request.resource.data.status == 'pendingVerification'
        && validText(request.resource.data.paymentReference, 4, 180)
        && request.resource.data.acceptedPolicies is map
        && validText(request.resource.data.acceptedPolicies.terms, 4, 40)
        && validText(request.resource.data.acceptedPolicies.shipping, 4, 40)
        && validText(request.resource.data.acceptedPolicies.cancellation, 4, 40)
        && validText(request.resource.data.acceptedPolicies.damageClaims, 4, 40)
        && request.resource.data.totalPaise is int
        && request.resource.data.totalPaise > 0
        && request.resource.data.totalPaise
          == request.resource.data.subtotalPaise
            + request.resource.data.shippingPaise
            - request.resource.data.discountPaise
        && (
          (
            request.resource.data.couponId == null
            && request.resource.data.couponCode == null
            && request.resource.data.couponStudioId == null
            && request.resource.data.discountPaise == 0
          )
          || (
            validText(request.resource.data.couponId, 3, 24)
            && validText(request.resource.data.couponCode, 3, 24)
            && validText(request.resource.data.couponStudioId, 1, 180)
            && exists(/databases/$(database)/documents/sellerCoupons/$(request.resource.data.couponId))
            && get(/databases/$(database)/documents/sellerCoupons/$(request.resource.data.couponId)).data.active == true
            && get(/databases/$(database)/documents/sellerCoupons/$(request.resource.data.couponId)).data.code == request.resource.data.couponCode
            && get(/databases/$(database)/documents/sellerCoupons/$(request.resource.data.couponId)).data.studioId == request.resource.data.couponStudioId
          )
        )
        && request.resource.data.adminNote == null
        && request.resource.data.verifiedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'customerId', 'addressId', 'items', 'subtotalPaise',
          'shippingPaise', 'discountPaise', 'couponId',
          'couponCode', 'couponStudioId', 'totalPaise',
          'paymentReference', 'acceptedPolicies',
          'status', 'adminNote', 'verifiedBy',
          'createdAt', 'updatedAt'
        ]);
      allow read: if founder() || (signedIn() && resource.data.customerId == uid());
      allow update, delete: if founder();
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if founder();
    }

    // PHASE_4_PRODUCT_MANAGEMENT
match /categories/{categoryId} {
  allow read: if true;
  allow create, update, delete: if isFounder();
}

match /collections/{collectionId} {
  allow read: if true;
  allow create, update, delete: if isFounder();
}

match /settings/productModeration {
  allow read: if isAuthenticated();
  allow write: if isFounder();
}

    // PHASE_5_PUBLIC_DISCOVERY
match /recentlyViewed/{userId} {
  allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
}

    // PHASE_6_CART_CHECKOUT_PAYMENTS
match /carts/{userId} {
  allow read, create, update, delete: if isAuthenticated()
    && request.auth.uid == userId
    && request.auth.token.email_verified == true;
}

match /addressBooks/{userId} {
  allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
}

match /paymentSessions/{sessionId} {
  allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
  allow write: if false;
}

    // PHASE_7_ORDER_LIFECYCLE
match /refundRequests/{requestId} {
  allow read: if isFounder()
    || (isAuthenticated() && resource.data.customerId == request.auth.uid)
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

match /payouts/{payoutId} {
  allow read: if isFounder()
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

match /sellerWithdrawals/{withdrawalId} {
  allow read: if isFounder()
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

    // PHASE_8_CUSTOM_ORDERS
match /customOrders/{customOrderId} {
  allow read: if isFounder()
    || (isAuthenticated() && resource.data.customerId == request.auth.uid)
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

match /customOrderDisputes/{disputeId} {
  allow read: if isFounder()
    || (isAuthenticated() && resource.data.customerId == request.auth.uid)
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

    // PHASE_9_CUSTOMER_ENGAGEMENT
match /reviews/{reviewId} {
  allow read: if resource.data.status == "published"
    || isFounder()
    || (isAuthenticated() && resource.data.customerId == request.auth.uid)
    || (isSeller() && resource.data.studioId == request.auth.token.studioId);
  allow write: if false;
}

match /wishlists/{userId}/items/{productId} {
  allow read: if isAuthenticated() && request.auth.uid == userId;
  allow write: if false;
}

match /studioFollows/{followId} {
  allow read: if isFounder()
    || (isAuthenticated() && resource.data.customerId == request.auth.uid);
  allow write: if false;
}

    // PHASE_10_FOUNDER_ADMIN
match /platformContent/{contentId} {
  allow read: if resource.data.status == "published" || isFounder();
  allow write: if false;
}
match /platformSettings/{settingId} {
  allow read: if isFounder() || settingId == "commerce";
  allow write: if false;
}
match /financeLedger/{entryId} {
  allow read: if isFounder();
  allow write: if false;
}
match /adminAuditLogs/{auditId} {
  allow read: if isFounder();
  allow write: if false;
}

    // PHASE_11_SELLER_GROWTH
match /sellerAnalyticsSummary/{studioId} {
  allow read: if isFounder() || (isSeller() && request.auth.token.studioId == studioId);
  allow write: if false;
}
match /sellerCoupons/{couponId} {
  allow get: if isAuthenticated();
  allow list: if isFounder()
    || (isSeller() && sameStudio(resource.data.studioId));
  allow create: if (
      isFounder()
      || (
        verified()
        && isSeller()
        && sameStudio(request.resource.data.studioId)
      )
    )
    && request.resource.data.couponId == couponId
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.code.matches('^[A-Z0-9_-]{3,24}$')
    && validText(request.resource.data.title, 3, 100)
    && request.resource.data.discountType in ['percentage', 'fixed']
    && request.resource.data.discountValue is int
    && (
      (
        request.resource.data.discountType == 'percentage'
        && request.resource.data.discountValue >= 1
        && request.resource.data.discountValue <= 90
      )
      || (
        request.resource.data.discountType == 'fixed'
        && request.resource.data.discountValue >= 100
        && request.resource.data.discountValue <= 100000000
      )
    )
    && request.resource.data.minimumOrderPaise is int
    && request.resource.data.minimumOrderPaise >= 0
    && request.resource.data.active is bool
    && request.resource.data.usedCount == 0
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      'couponId', 'studioId', 'code', 'title', 'discountType',
      'discountValue', 'minimumOrderPaise', 'active', 'usedCount',
      'createdBy', 'createdAt', 'updatedAt'
    ]);
  allow update: if isFounder()
    || (
      verified()
      && isSeller()
      && sameStudio(resource.data.studioId)
      && request.resource.data.couponId == resource.data.couponId
      && request.resource.data.studioId == resource.data.studioId
      && request.resource.data.code == resource.data.code
      && request.resource.data.createdBy == resource.data.createdBy
      && request.resource.data.updatedAt == request.time
      && changedOnly(['active', 'updatedAt'])
    );
  allow delete: if false;
}
match /customerSegments/{segmentId} {
  allow read: if isFounder()
    || (isSeller() && sameStudio(resource.data.studioId));
  allow create: if (
      isFounder()
      || (
        verified()
        && isSeller()
        && sameStudio(request.resource.data.studioId)
      )
    )
    && request.resource.data.segmentId == segmentId
    && request.resource.data.createdBy == request.auth.uid
    && validText(request.resource.data.name, 3, 100)
    && validText(request.resource.data.description, 3, 500)
    && request.resource.data.rule in [
      'all', 'repeatCustomers', 'highValue',
      'inactive', 'wishlistIntent'
    ]
    && request.resource.data.customerCount == 0
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      'segmentId', 'studioId', 'name', 'description', 'rule',
      'customerCount', 'createdBy', 'createdAt', 'updatedAt'
    ]);
  allow update, delete: if isFounder();
}
match /sellerCampaigns/{campaignId} {
  allow read: if isFounder()
    || (isSeller() && sameStudio(resource.data.studioId));
  allow create: if (
      isFounder()
      || (
        verified()
        && isSeller()
        && sameStudio(request.resource.data.studioId)
      )
    )
    && request.resource.data.campaignId == campaignId
    && request.resource.data.createdBy == request.auth.uid
    && validText(request.resource.data.name, 3, 100)
    && validText(request.resource.data.subject, 3, 140)
    && validText(request.resource.data.message, 10, 5000)
    && validText(request.resource.data.segmentId, 1, 180)
    && exists(/databases/$(database)/documents/customerSegments/$(request.resource.data.segmentId))
    && get(/databases/$(database)/documents/customerSegments/$(request.resource.data.segmentId)).data.studioId == request.resource.data.studioId
    && request.resource.data.status == 'draft'
    && request.resource.data.sentCount == 0
    && request.resource.data.deliveredCount == 0
    && request.resource.data.openedCount == 0
    && request.resource.data.clickedCount == 0
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      'campaignId', 'studioId', 'name', 'subject', 'message',
      'segmentId', 'status', 'sentCount', 'deliveredCount',
      'openedCount', 'clickedCount', 'createdBy',
      'createdAt', 'updatedAt'
    ]);
  allow update, delete: if isFounder();
}

    // PHASE_13_HARDENING_AND_LAUNCH
match /securitySignals/{signalId} {
  allow read: if isFounder();
  allow write: if false;
}
match /releaseEvidence/{evidenceId} {
  allow read: if isFounder();
  allow write: if false;
}
match /releaseBugs/{bugId} {
  allow read: if isFounder();
  allow write: if false;
}
match /backupRuns/{backupRunId} {
  allow read: if isFounder();
  allow write: if false;
}
match /performanceRuns/{runId} {
  allow read: if isFounder();
  allow write: if false;
}
match /loadTestRuns/{runId} {
  allow read: if isFounder();
  allow write: if false;
}

}
}
